# Copia este archivo como .env y ajusta los valores.
#   Windows PowerShell:  copy .env.example .env
#
# Estos valores sirven tal cual si levantas la base con Docker:
#   docker compose up -d

# Base de datos local (usuario, contrasena y nombre salen de docker-compose.yml)
DATABASE_URL="postgresql://colegio:colegio123@localhost:5432/colegio"

# En local es la misma. En la nube (Neon) aqui va la cadena SIN -pooler,
# porque las migraciones no pasan por el pooler.
DIRECT_URL="postgresql://colegio:colegio123@localhost:5432/colegio"

# Firma las sesiones. Genera uno propio, no uses este:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambia-esto-por-uno-aleatorio-de-al-menos-32-caracteres"

# Las usa prisma/seed.ts para crear los dos usuarios iniciales.
# Minimo 8 caracteres. El seed falla a proposito si no estan.
ADMIN_PASSWORD="Admin123!"
MAESTRO_PASSWORD="Maestro123!"
